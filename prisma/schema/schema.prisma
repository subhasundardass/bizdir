}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business {
  id                                      BigInt                   @id @default(autoincrement())
  slug                                    String                   @unique
  name                                    String
  name_norm                               String?                  @default(dbgenerated("norm_text(name)"))
  owner_user_id                           BigInt?
  address                                 String?
  city_id                                 Int
  locality_id                             Int?
  pincode                                 String?
  geom                                    Unsupported("geography")
  phone                                   String
  whatsapp                                String?
  email                                   String?
  website                                 String?
  description                             String?
  year_established                        Int?                     @db.SmallInt
  price_level                             Int?                     @db.SmallInt
  is_24x7                                 Boolean                  @default(false)
  verified                                Boolean                  @default(false)
  rating                                  Decimal                  @default(0) @db.Decimal(2, 1)
  review_count                            Int                      @default(0)
  status                                  String                   @default("pending")
  source                                  String                   @default("owner")
  created_at                              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime                 @default(now()) @db.Timestamptz(6)
  source_ref                              String?
  phone_verified_at                       DateTime?                @db.Timestamptz(6)
  name_local                              String?
  location_business_city_idTolocation     location                 @relation("business_city_idTolocation", fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location_business_locality_idTolocation location?                @relation("business_locality_idTolocation", fields: [locality_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user                                app_user?                @relation(fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_alias                          business_alias[]
  business_attribute                      business_attribute[]
  business_claim                          business_claim[]
  business_closure                        business_closure[]
  business_concept                        business_concept?
  business_hours                          business_hours[]
  business_media                          business_media[]
  business_subscription                   business_subscription[]
  click_log                               click_log[]
  lead                                    lead[]
  review                                  review[]
  search_impression                       search_impression[]

  @@unique([source, source_ref], map: "business_source_ref_idx", where: raw("(source_ref IS NOT NULL)"))
  @@index([city_id], map: "business_city_active_idx", where: raw("(status = 'active'::text)"))
  @@index([geom], map: "business_geom_active_idx", type: Gist, where: raw("(status = 'active'::text)"))
  @@index([locality_id], map: "business_locality_idx", where: raw("(status = 'active'::text)"))
  @@index([name_norm(ops: raw("gin_trgm_ops"))], map: "business_name_trgm_idx", type: Gin)
  @@index([owner_user_id], map: "business_owner_idx")
  @@index([phone])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model business_attribute {
  business_id                                                                  BigInt
  attribute_id                                                                 Int
  id                                                                           BigInt            @id @default(autoincrement())
  value_number                                                                 Decimal?          @db.Decimal
  option_id                                                                    Int?
  attribute                                                                    attribute         @relation(fields: [attribute_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business                                                                     business          @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute_option_business_attribute_option_id_attribute_idToattribute_option attribute_option? @relation("business_attribute_option_id_attribute_idToattribute_option", fields: [option_id, attribute_id], references: [id, attribute_id], onDelete: NoAction, onUpdate: NoAction, map: "business_attribute_option_fk")
  attribute_option_business_attribute_option_idToattribute_option              attribute_option? @relation("business_attribute_option_idToattribute_option", fields: [option_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([attribute_id], map: "business_attribute_attr_idx")
  @@index([attribute_id, value_number], map: "business_attribute_number_idx", where: raw("(value_number IS NOT NULL)"))
  @@index([option_id], map: "business_attribute_option_idx", where: raw("(option_id IS NOT NULL)"))
}

model business_concept {
  business_id BigInt   @unique(map: "business_one_primary_idx", where: raw("is_primary"))
  concept_id  Int
  is_primary  Boolean  @default(false)
  business    business @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  concept     concept  @relation(fields: [concept_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([business_id, concept_id])
  @@index([concept_id], map: "business_concept_concept_idx")
}

